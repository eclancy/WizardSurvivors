[ext_resource type="Script" path="res://scripts/Stormsweep.cs" id="1"]

; Every arc of storm-light: one node, a child of the Player, that carries the arcs of every cast in a
; fixed pool and draws them itself. No sprite, no collision shape - an arc strikes what its drawn line
; sweeps across, so the drawn hit and the real hit are the same number by construction.
[node name="Stormsweep" type="Node2D"]
script = ExtResource("1")
BaseHalfBand = 22.0
HandReach = 14.0
ArcGap = 0.14
