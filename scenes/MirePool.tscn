[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/LingeringZone.cs" id="1"]

; One puddle of the Mirefoot trail. Generic on purpose - LingeringZone knows nothing about
; Mirefoot, so anything later that wants to leave something on the floor reuses this scene with
; different numbers instead of growing a third copy of the same twenty lines. It does not draw
; itself: the trail's MireSurface draws every pool together, as one bog under the actors.
[node name="MirePool" type="Node2D"]
script = ExtResource("1")
Radius = 46.0
Duration = 4.5
TickSeconds = 0.45
AppliesSlow = true
SlowMultiplier = 0.6
DrawsItself = false
