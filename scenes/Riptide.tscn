[ext_resource type="Script" path="res://scripts/ElementalBolt.cs" id="1"]
[ext_resource type="Script" path="res://scripts/RiptideWave.cs" id="2_wave"]

[sub_resource type="CircleShape2D" id="CircleShape2D_riptide"]
radius = 8.0

[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_riptide"]
lifetime_randomness = 0.4
particle_flag_disable_z = true
emission_shape = 1
emission_sphere_radius = 5.0
direction = Vector3(-1, 0, 0)
spread = 25.0
gravity = Vector3(0, 0, 0)
scale_min = 0.4
scale_max = 1.0
color = Color(0.706, 0.863, 1.0, 0.7)

; Homing is off, which is the whole shape of the spell. Every other bolt in the game curves onto
; the nearest enemy, so a crowd of forty gets hit forty times in forty places; this one is aimed
; once and then travels, so where the player is standing when it fires decides what it hits. That
; is also why the pierce is high and the damage is not - it is a line, not a shot.
;
; The wave draws itself (scripts/RiptideWave.cs) out of the bolt's own hit radius. ElementalBolt
; replaces this circle in _Ready with a capsule lying across the heading (CrestDepthFraction): the
; swath as wide as the crest, and only as deep as its face. The 8.0 here is the editor's default.
; The wave grows every level (the Area lines in SpellData_Riptide.tres), and pierces 6 so a wider
; wave is not spent on the first rank it meets.
; z_index 2 keeps the crest over the swarm and over Spring Tide's flooded lane (1), under the
; status marks (3). The trail particles are the spray it leaves, in the Water ramp's hot tone.
[node name="Riptide" type="Area2D"]
collision_mask = 2
script = ExtResource("1")
BaseSpeed = 300.0
BaseDuration = 2.2
BasePierce = 6
CrestDepthFraction = 0.35
Homing = false
GuaranteedSlow = true
SlowMultiplier = 0.7
SlowDuration = 1.5

[node name="Wave" type="Node2D" parent="."]
z_index = 2
script = ExtResource("2_wave")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_riptide")

[node name="TrailParticles" type="GPUParticles2D" parent="."]
amount = 10
process_material = SubResource("ParticleProcessMaterial_riptide")
