[node name="Feet" type="CharacterBody2D" parent="."]
; The footprint the ground is measured against (Player.ConfigureEntityCollision, MovePlayer):
; water and maze walls stop the boots, not the body. No layer, so nothing can hit it; its one
; mask bit is LevelTilePainter.TerrainCollisionLayer (4), and the script sets both again.
collision_layer = 0
collision_mask = 8
motion_mode = 1

[node name="CollisionShape2D" type="CollisionShape2D" parent="Feet"]
; A capsule on its side, 56 wide and 16 deep, its bottom on the bottom of a 48 px character cell
; at x2 (sprite y -4, +48 = 44): the stance the boots are drawn in. Player.FitFeetToSprite moves
; it for any other cell size, which is why the 32 px placeholder idle here looks short of it.
position = Vector2(0, 36)
rotation = 1.5707964
shape = SubResource("CapsuleShape2D_feet")

[node name="AnimatedSprite2D" type="AnimatedSprite2D" parent="."]
