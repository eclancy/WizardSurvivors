[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/LanternTenderEnemy.cs" id="1_tender"]
[ext_resource type="SpriteFrames" path="res://scenes/resources/SwampLanternTenderFrames.tres" id="2_frames"]

; The torso, not the crook or the hem: about 60 px of coat at x2. The sprite is raised 28 px so this
; circle sits on the figure's centre of mass, which is also where spells aim.
[sub_resource type="CircleShape2D" id="CircleShape2D_tender"]
radius = 30.0

; The Blighted Swamp side event's last fight (scripts/BogLanternsEvent.cs, .ai/side-events.md):
; the lantern-tender, carrying one of the bog lanterns. Health is set at spawn from the run's
; spawn health times BogLanternsEvent.TenderHealthMultiplier; the 900 here is only for a scene
; opened on its own. Every attack's numbers are LanternTenderEnemy's defaults.
[node name="SwampLanternTender" type="CharacterBody2D"]
collision_layer = 2
collision_mask = 3
script = ExtResource("1_tender")
Speed = 84.0
Health = 900
EnemyType = "SwampLanternTender"
MinPlayerSeparation = 40.0
EnemySpacingRadius = 90.0
IsMiniBoss = true
HeavyDeath = true
ContactDamage = 2
KnockbackResistance = 0.7
MinSlowMultiplier = 0.35

[node name="AnimatedSprite2D" type="AnimatedSprite2D" parent="."]
; On the 96 cell at the contract's one render scale (tools/art/swamp_tender.py): a ~144 px figure
; under a crook and lantern that reach ~180 px - about twice an ordinary swamp creature.
position = Vector2(0, -28)
scale = Vector2(2, 2)
sprite_frames = ExtResource("2_frames")
animation = &"moving"
autoplay = "moving"

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_tender")
