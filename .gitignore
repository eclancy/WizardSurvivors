# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

.vs/
.vscode/
bin/
obj/
.vscode/settings.json

# Generated imported fantasy manifest mirror; source/curated art assets should be tracked.
assets/imported/fantasy/manifests/source_mirror/

# Claude Code — everything else under .claude/ is committed on purpose.
.claude/settings.local.json

# Generated preview and scratch output from tools/art (the generators are tracked, not their renders).
tools/art/_*
*.pyc

# Audio audition reels written by tools/audio/build.py --preview. Working files:
# regenerate them, do not commit megabytes of WAV that nothing loads.
tools/audio/_preview_*.wav
