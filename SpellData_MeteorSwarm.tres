[ext_resource type="Texture2D" path="res://assets/bonelight/ui/spells/meteor-swarm-fire.png" id="3_explosion_icon"]

; A volley of meteors, one after another, each on a random enemy in range (scripts/MeteorImpact.cs,
; Player.FireMeteorSwarm). BaseDamage is ONE METEOR; BaseProjectileCount is the meteors in a volley.
;
; The web demo's count: 2 + level, so 3 at level 1 and one more at every level after, to 10 at level 8.
; It used to fire a fixed four whatever the card said. The table is written out in full so
; Player.EnsureRelevantLevelUps generates nothing of its own: every level adds a meteor and damage
; (+3 at level 2, as it always had, then +1), even levels the cooldown step every spell gets, level 3
; the blast (Effect 7, AreaSize, read as a fraction: +16%) and level 5 the reach it picks targets in.

[sub_resource type="Resource" id="Resource_meteorswarm_lvl2"]
script = ExtResource("2")
Level = 2
DamageBonus = 3
CooldownBonus = -0.08
ProjectileCountBonus = 1

