[sub_resource type="Resource" id="Resource_obsidianspike_lvl2"]
script = ExtResource("2")
Level = 2
DamageBonus = 3

; Levels 3 to 7 used to change nothing. Once upgrades stopped being on every level-up, a Geomancer
; spent his scarce ones on blank levels and could not hold the swarm.
[sub_resource type="Resource" id="Resource_obsidianspike_lvl5"]
script = ExtResource("2")
Level = 5
DamageBonus = 2

[sub_resource type="Resource" id="Resource_obsidianspike_lvl7"]
script = ExtResource("2")
Level = 7
CooldownBonus = -0.2

; BaseCooldown 1.3, from 1.8 (2026-10-12): one eruption on one enemy could not hold the swarm in the
; 30-minute economy - the Geomancer finished level 18 at a third of the other wizards' damage.
[resource]
script = ExtResource("1")
Id = "obsidian_spike"
Name = "Obsidian Spike"
CurrentLevel = 1
MaxLevel = 8
BaseDamage = 7
BaseCooldown = 1.3
BaseProjectileCount = 1
BaseRange = 400.0
LevelUpgrades = Array[ExtResource("2")]([SubResource("Resource_obsidianspike_lvl2"), SubResource("Resource_obsidianspike_lvl5"), SubResource("Resource_obsidianspike_lvl7")])
Description = "Erupts a spike of black stone beneath the nearest enemy."
Icon = ExtResource("3_spikes_icon")
; Pure Earth as of the starter rework. The Darkness half was flavour taken from the word
; "black" in the name, and it cost the Geomancer a coherent opening: a starting spell that
; splits its weight leaves the character pointed at two elements and short of the first tier
; in either. It also separates this from Glacial Spike, which is the Earth/Ice hybrid.
ElementWeights = {
"Earth": 1
}

