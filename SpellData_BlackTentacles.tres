[ext_resource type="Texture2D" path="res://assets/bonelight/ui/spells/black-tentacles-poison.png" id="3_black_hole_icon"]

; A rift that slows and tentacles that slap (scripts/BlackTentacles.cs). BaseDamage is ONE SLAP;
; the rift itself deals none. BaseProjectileCount is the number of tentacles.
;
; "Level ups for black tentacles increase the slow, area, as well as the number of tentacles
; slapping enemies." So the table alternates: even levels add a tentacle (and the cooldown step
; every spell gets on even levels), odd levels widen the rift by 10 px (Effect 7, AreaSize; 90 -> 120 by level 7) and
; deepen its slow by 4% (Effect 9, SlowPower; 0.45 -> 0.33 by level 7), and every level adds 1 to
; the slap. Level 6 also lets the slow linger 0.35 s longer after an enemy steps out (Effect 10).
; It is written out in full so Player.EnsureRelevantLevelUps generates nothing of its own - the old
; table had one entry, and the level-ups the code invented for it included an "Area +0.16" that
; the spell never read.

[sub_resource type="Resource" id="Resource_blacktentacles_lvl2"]
script = ExtResource("2")
Level = 2
DamageBonus = 1
CooldownBonus = -0.08
ProjectileCountBonus = 1

