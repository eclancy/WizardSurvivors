{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Godot Project",
			"type": "shell",
			"command": "C:\Program Files (x86)\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64_console.exe",
			"args": ["--path", "${workspaceFolder}"],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Build (dotnet)",
			"type": "shell",
			"command": "dotnet",
			"args": ["build", "WizardSurvivors.sln", "-v", "q", "--nologo"],
			"isBackground": false,
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
