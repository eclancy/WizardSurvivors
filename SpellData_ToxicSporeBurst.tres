[resource]
script = ExtResource("1")
Id = "toxic_spore_burst"
Name = "Toxic Spore Burst"
CurrentLevel = 1
MaxLevel = 8
BaseDamage = 6
BaseCooldown = 2.8
BaseProjectileCount = 3
BaseRange = 280.0
LevelUpgrades = Array[ExtResource("2")]([SubResource("Resource_toxicspore_lvl2"), SubResource("Resource_toxicspore_lvl3"), SubResource("Resource_toxicspore_lvl4"), SubResource("Resource_toxicspore_lvl5"), SubResource("Resource_toxicspore_lvl6"), SubResource("Resource_toxicspore_lvl7_area"), SubResource("Resource_toxicspore_lvl7_poison"), SubResource("Resource_toxicspore_lvl8")])
Description = "Sows mushrooms among the enemies around you. Each sprouts, swells, and bursts in a cloud of spores that hits and poisons everything inside its ring."
