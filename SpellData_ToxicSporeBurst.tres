[ext_resource type="Texture2D" path="res://assets/bonelight/ui/spells/spore-burst-green.png" id="3_icon"]

; Mushrooms sown among the enemies (scripts/SporeMushroom.cs). BaseDamage is ONE BURST, on everything
; inside its radius; BaseProjectileCount is the mushrooms a cast sows; BaseRange is how far from the
; player they may be sown. The burst radius itself is SporeMushroom.BaseBurstRadius (80 px) plus the
; AreaSize lines below (Effect 7, in pixels), times every area multiplier there is. The poison is
; SporeMushroom.BasePoisonTick (2 a second for 3 s) plus the DotDamage lines (Effect 12).
;
; "upgrade toxic spore burst ... it should spawn mushroom spores that explode around the map", so the
; table grows all three things a player can see: even levels add a mushroom (2, 6, 8) or the poison
; (4) with the cooldown step every spell gets on even levels, odd levels widen the burst by 8 px
; (80 -> 104 by level 7) and level 7 deepens the poison again, and every level adds 1 to the burst.
; Written out in full so Player.EnsureRelevantLevelUps generates nothing of its own - the old table
; had one entry, and the lines the code invented for it ("Area +0.16", "DoT per tick +1") were read
; by nothing.

[sub_resource type="Resource" id="Resource_toxicspore_lvl2"]
script = ExtResource("2")
Level = 2
DamageBonus = 1
CooldownBonus = -0.08
ProjectileCountBonus = 1

